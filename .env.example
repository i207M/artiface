# Optional Compose overrides. Copy to .env before changing values.
# Defaults use the published image and listen only on this machine.
ARTIFACE_IMAGE=ghcr.io/i207m/artiface:latest
ARTIFACE_DATA_DIR=./data
ARTIFACE_BIND_IP=127.0.0.1
ARTIFACE_APP_ORIGIN=http://127.0.0.1:8787
ARTIFACE_MODE=personal
ARTIFACE_DISABLE_SSH=false

# ARTIFACE_APP_ORIGIN initializes a missing configuration.
# Edit the saved appOrigin in data/config.json for an existing installation.
# One-time CLI setup/import can accept ARTIFACE_PASSWORD from its environment.
# Do not persist that password in the running service or this file.
# Mount folders to display with explicit read-only volumes in compose.yaml.
# SSH import mounts ~/.ssh only for its one-time command, never for this service.
