# Only application sources, frontend inputs, and the license enter the build context.
**
!LICENSE
!go.mod
!go.sum
!cmd/artiface/*.go
!internal/**/*.go
!internal/server/preview_bridge.js
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/embed.go
!web/src/**/*.ts
!web/src/**/*.tsx
!web/src/**/*.css
!web/public/**/*.svg
!web/public/**/*.png
!web/public/**/*.webmanifest
!web/public/**/*.js

# Keep private state and generated files excluded even below allowed directories.
**/*_test.go
**/.git
**/.local
**/.ssh
**/.env
**/.env.*
**/*local.json
**/*.ssh.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/id_*
**/node_modules
**/dist
**/test-results
**/playwright-report
